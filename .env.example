# ==============================================================================
# .env.example — Template for Environment Variables
# ==============================================================================
#
# WHAT: Shows what environment variables the system COULD use in the future.
# WHY:  Credentials must NEVER be hard-coded in source code.
#        Environment variables are the standard secure alternative.
#
# HOW TO USE:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your values (if/when you have a broker API)
#   3. NEVER commit the .env file (it's in .gitignore)
#
# IMPORTANT:
#   - This is a TEMPLATE — it contains NO real credentials
#   - The .env file is in .gitignore — Git will NOT track it
#   - The simulator does NOT require any credentials to run
#   - These are only needed IF live trading is enabled in the future
#
# ==============================================================================

# Trading mode (simulation | paper)
# Live is NOT supported
TRADING_MODE=simulation

# Broker API credentials (FUTURE USE — NOT REQUIRED NOW)
# BROKER_API_KEY=your_api_key_here
# BROKER_API_SECRET=your_api_secret_here
# BROKER_API_URL=https://api.example.com

# Data provider credentials (FUTURE USE — NOT REQUIRED NOW)
# DATA_API_KEY=your_data_api_key_here
# DATA_API_URL=https://data.example.com
